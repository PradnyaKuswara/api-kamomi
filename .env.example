NODE_ENV=development
PORT=8080

# Postgres. Boleh format JDBC lama (jdbc:postgresql://host:5432/db) atau postgres://
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Ukuran pool koneksi Postgres (default 5 / 0). Naikkan di produksi sesuai max_connections.
DB_POOL_MAX=5
DB_POOL_MIN=0

# JWT (HS256/384/512 dipilih dari panjang secret, sama seperti jjwt di versi Java)
JWT_SECRET=
# Dalam milidetik, sama seperti versi Java
JWT_EXPIRATION=86400000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@kamomi.com

# Frontend (CORS + redirect OAuth)
FRONTEND_URL=http://localhost:4321

# true bila di belakang reverse proxy tepercaya
TRUST_PROXY=false
RATE_LIMIT=true
